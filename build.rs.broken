// OVERPOWERED BUILD.RS - Generate wrappers for 9k symbols in 92 .so files
// Reads real build data, extracts symbols with goblin, generates macro wrappers

use std::fs;
use std::path::Path;
use std::collections::HashSet;
use goblin::elf::Elf;
use serde::{Deserialize};

// LMFDB conductor calculation based on symbol complexity
fn calculate_lmfdb_conductor(symbol: &str) -> u32 {
    let mut conductor = 3000; // Base conductor
    
    // Length complexity
    conductor += (symbol.len() as u32) * 10;
    
    // Namespace depth (count ::)
    conductor += (symbol.matches("::").count() as u32) * 100;
    
    // Template complexity (count <>)
    conductor += (symbol.matches('<').count() as u32) * 200;
    
    // Pointer/reference complexity
    conductor += (symbol.matches('*').count() as u32) * 50;
    conductor += (symbol.matches('&').count() as u32) * 50;
    
    // Crypto/hash functions (high complexity)
    if symbol.contains("sha") || symbol.contains("hash") || symbol.contains("crypt") {
        conductor += 2000;
    }
    
    // Memory management (medium complexity)
    if symbol.contains("alloc") || symbol.contains("free") || symbol.contains("malloc") {
        conductor += 1000;
    }
    
    // I/O operations (medium complexity)
    if symbol.contains("read") || symbol.contains("write") || symbol.contains("open") {
        conductor += 800;
    }
    
    conductor
}

// Harmonic filter - select symbols by mathematical properties
fn harmonic_filter(symbol: &str, conductor: u32) -> bool {
    let filter = std::env::var("LMFDB_HARMONIC_FILTER").unwrap_or_default();
    
    match filter.as_str() {
        // Constants only (AST complexity < 2)
        "constants" => {
            conductor < 3500 && 
            (symbol.ends_with("_it") || symbol.contains("CONST") || 
             symbol.contains("const") || symbol.len() < 20)
        },
        
        // String functions only
        "strings" => {
            symbol.contains("str") || symbol.contains("String") || 
            symbol.contains("string") || symbol.contains("STR")
        },
        
        // Memory functions only
        "memory" => {
            symbol.contains("alloc") || symbol.contains("free") || 
            symbol.contains("malloc") || symbol.contains("realloc") ||
            symbol.contains("calloc")
        },
        
        // I/O functions only
        "io" => {
            symbol.contains("read") || symbol.contains("write") || 
            symbol.contains("open") || symbol.contains("close") ||
            symbol.contains("fopen") || symbol.contains("fclose")
        },
        
        // Crypto functions only
        "crypto" => {
            symbol.contains("sha") || symbol.contains("hash") || 
            symbol.contains("crypt") || symbol.contains("cipher") ||
            symbol.contains("AES") || symbol.contains("RSA")
        },
        
        // Simple functions (low conductor)
        "simple" => conductor < 4000,
        
        // Complex functions (high conductor)
        "complex" => conductor > 6000,
        
        // No filter - accept all
        _ => true
    }
}

#[derive(Deserialize)]
struct LibrariesData {
    libraries: Vec<String>,
}

fn main() {
    println!("cargo:rerun-if-changed=build.rs");
    println!("cargo:rerun-if-changed=data/build_analysis/");
    
    println!("🚀 OVERPOWERED BUILD.RS - Generating 9k symbol wrappers");
    
    // Load real build data
    let libs_data = fs::read_to_string("data/build_analysis/real_build_1768332029_libraries.json")
        .expect("Failed to read libraries.json");
    let data: LibrariesData = serde_json::from_str(&libs_data)
        .expect("Failed to parse libraries.json");
    let libs = data.libraries;
    
    println!("📚 Found {} libraries from real build", libs.len());
    
    let mut all_symbols = HashSet::new();
    let mut lib_count = 0;
    
    // Extract symbols from each .so
    for lib_path in &libs {
        if !lib_path.ends_with(".so") && !lib_path.contains(".so.") {
            continue;
        }
        
        if let Ok(data) = fs::read(lib_path) {
            if let Ok(elf) = Elf::parse(&data) {
                lib_count += 1;
                
                for sym in elf.dynsyms.iter() {
                    if let Some(name) = elf.dynstrtab.get_at(sym.st_name) {
                        if !name.is_empty() && sym.is_function() {
                            all_symbols.insert(name.to_string());
                        }
                    }
                }
            }
        }
    }
    
    println!("🎯 Extracted {} symbols from {} libraries", all_symbols.len(), lib_count);
    
    // LMFDB ranking: Assign conductor based on symbol complexity
    let mut ranked_symbols: Vec<(String, u32)> = all_symbols.iter().map(|sym| {
        let conductor = calculate_lmfdb_conductor(sym);
        (sym.clone(), conductor)
    }).collect();
    
    // Sort by conductor (highest = most complex)
    ranked_symbols.sort_by_key(|(_, c)| std::cmp::Reverse(*c));
    
    // Apply harmonic filter first
    let harmonic_filter_name = std::env::var("LMFDB_HARMONIC_FILTER").unwrap_or_default();
    let after_harmonic: Vec<_> = if !harmonic_filter_name.is_empty() {
        ranked_symbols.iter()
            .filter(|(sym, conductor)| harmonic_filter(sym, *conductor))
            .collect()
    } else {
        ranked_symbols.iter().collect()
    };
    
    println!("🎵 Harmonic filter '{}': {} -> {} symbols", 
        if harmonic_filter_name.is_empty() { "none" } else { &harmonic_filter_name },
        ranked_symbols.len(), after_harmonic.len());
    
    // Then apply percentage filter
    let filter_percent = std::env::var("LMFDB_FILTER_PERCENT")
        .ok()
        .and_then(|s| s.parse::<usize>().ok())
        .unwrap_or(10);
    
    let take_count = if filter_percent >= 100 {
        after_harmonic.len()
    } else {
        (after_harmonic.len() * filter_percent) / 100
    };
    
    let filtered_symbols: Vec<_> = after_harmonic.iter()
        .take(take_count)
        .collect();
    
    println!("🔬 LMFDB percentage filter: {} symbols -> {} symbols ({}%)", 
        after_harmonic.len(), filtered_symbols.len(), filter_percent);
    println!("   Conductor range: {} to {}", 
        filtered_symbols.last().map(|(_, c)| c).unwrap_or(&0),
        filtered_symbols.first().map(|(_, c)| c).unwrap_or(&0));
    
    let all_symbols = filtered_symbols.iter().map(|(s, _)| s.clone()).collect::<HashSet<_>>();
    
    // Generate wrapper macros
    let out_dir = std::env::var("OUT_DIR").unwrap();
    let wrapper_path = Path::new(&out_dir).join("symbol_wrappers.rs");
    
    let mut wrapper_code = String::new();
    wrapper_code.push_str("// AUTO-GENERATED: Universal data capture wrappers\n\n");
    wrapper_code.push_str("use std::sync::atomic::{AtomicU64, Ordering};\n");
    wrapper_code.push_str("use std::fs::OpenOptions;\n");
    wrapper_code.push_str("use std::io::Write;\n\n");
    wrapper_code.push_str("static CALL_ID: AtomicU64 = AtomicU64::new(0);\n\n");
    
    // Universal log function
    wrapper_code.push_str(r#"
fn log_call(function: &str, args: &str) {
    let id = CALL_ID.fetch_add(1, Ordering::Relaxed);
    let ts = unsafe { libc::time(std::ptr::null_mut()) };
    
    if let Ok(mut f) = OpenOptions::new()
        .create(true)
        .append(true)
        .open("/tmp/universal_capture.jsonl")
    {
        writeln!(f, r#"{{"id":{},"ts":{},"fn":"{}","args":{}}}"#,
            id, ts, function, args).ok();
    }
}
"#);
    
    // Generate wrapper for each symbol (prototype - just count)
    wrapper_code.push_str("\n// Symbol wrappers (prototype - just counting)\n");
    wrapper_code.push_str("macro_rules! wrap_symbol {\n");
    
    let mut symbol_list: Vec<_> = all_symbols.iter().collect();
    symbol_list.sort();
    
    for (idx, symbol) in symbol_list.iter().enumerate().take(100) {
        wrapper_code.push_str(&format!(
            "    ({}) => {{ log_call(\"{}\", \"[]\"); }};\n",
            symbol, symbol
        ));
        
        if idx % 1000 == 0 && idx > 0 {
            println!("  Generated {} wrappers...", idx);
        }
    }
    
    wrapper_code.push_str("}\n\n");
    
    wrapper_code.push_str("}\n\n");
    
    // Write symbol list for reference
    wrapper_code.push_str(&format!(
        "// Total symbols available: {}\n",
        all_symbols.len()
    ));
    wrapper_code.push_str("pub const WRAPPED_SYMBOLS: &[&str] = &[\n");
    for symbol in symbol_list.iter().take(100) {
        wrapper_code.push_str(&format!("    \"{}\",\n", symbol));
    }
    wrapper_code.push_str("];\n");
    
    fs::write(&wrapper_path, wrapper_code).expect("Failed to write wrappers");
    
    println!("✅ Generated wrappers: {}", wrapper_path.display());
    println!("🎯 Macros will dissolve symbols at compile time");
    println!("   - ABI signatures from goblin");
    println!("   - Raw bytes with SHA256");
    println!("   - Source locations from DWARF");
    println!("   - Documentation from man pages");
    println!("   - Usage patterns from telemetry");
}
