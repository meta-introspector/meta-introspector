[Unit]
Description=ZOS Server - qa-node
After=network.target

[Service]
Type=simple
User=mdupont
WorkingDirectory=/home/mdupont/meta-introspector/repos/zos-qa
Environment="ZOS_ENV=qa"
Environment="ZOS_NODE_ID=local-qa-node"
ExecStart=/home/mdupont/meta-introspector/repos/zos-qa/target/release/zos_server
Restart=always

[Install]
WantedBy=multi-user.target
